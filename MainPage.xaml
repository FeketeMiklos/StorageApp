<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StorageApp.MainPage">

    <VerticalStackLayout Padding="10" Spacing="10">
        <Label Text="Products in store"
               FontSize="30"
               FontAttributes="Bold"
               HorizontalOptions="Center"/>

        <CollectionView x:Name="ProductsList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="AliceBlue"
                            Stroke="#B8D4E8"
                            StrokeThickness="1"
                            Padding="10"
                            Margin="10,5"
                            StrokeShape="RoundRectangle 12"
                            x:Name="BorderStyle">
                        
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                 Binding="{Binding Quantity}"
                                 Value="0">
                                <Setter Property="BackgroundColor" Value="#fa8072" />
                            </DataTrigger>
                        </Border.Triggers>
                        
                        <VerticalStackLayout Padding="10" Spacing="4">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="{Binding Name}"
                                       FontSize="25"
                                       FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>

                                <Label Text="{Binding Barcode, StringFormat='#{0}'}" FontSize="25" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="10">
                                <Label Text="{Binding Price, StringFormat='Price: {0:F2}'}" FontSize="18"/>

                                <Label Text="{Binding Quantity, StringFormat='Quantity: {0}'}" FontSize="18"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>

</ContentPage>
