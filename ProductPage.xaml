<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StorageApp.ProductPage"
             Title="Product">

    <VerticalStackLayout Padding="10" Spacing="20">

        <Grid ColumnDefinitions="Auto,*"
            ColumnSpacing="10">

            <Label Grid.Column="0"
                Text="Name:"
                FontSize="25"
                FontAttributes="Bold"
                VerticalTextAlignment="Center" />

            <Border Grid.Column="1"
                HeightRequest="50"
                VerticalOptions="Center">

                <Entry x:Name="productName"
                    Margin="10"
                    Placeholder="Enter product name"
                    FontSize="18"
                    HeightRequest="35" 
                    />
            </Border>
        </Grid>
        
        <Grid ColumnDefinitions="Auto,*"
            ColumnSpacing="10">

            <Label Grid.Column="0"
                Text="Barcode:"
                FontSize="25"
                FontAttributes="Bold"
                VerticalTextAlignment="Center" />

            <Border Grid.Column="1"
                HeightRequest="50"
                VerticalOptions="Center">   

                <Entry x:Name="productBarcode"
                    Margin="10"
                    Placeholder="Enter product barcode"
                    FontSize="18"
                    HeightRequest="35" />
            </Border>
        </Grid>

        <Grid ColumnDefinitions="Auto, *,Auto"
            ColumnSpacing="10">

            <Label Grid.Column="0"
                Text="Price:"
                FontSize="25"
                FontAttributes="Bold"
                VerticalTextAlignment="Center" />

            <Border Grid.Column="1"
                HeightRequest="50"
                VerticalOptions="Center">

                <Entry x:Name="productPrice"
                    Margin="10"
                    Placeholder="Enter product price"
                    FontSize="18"
                    HeightRequest="35" 
                    Keyboard="Numeric"
                    />
            </Border>
            
            <Label Grid.Column="2"
                Text="$"
                FontSize="25"
                FontAttributes="Bold"
                VerticalTextAlignment="Center" />
        </Grid>

        <Grid ColumnDefinitions="Auto,*"
            ColumnSpacing="10">

            <Label Grid.Column="0"
                Text="Quantity:"
                FontSize="25"
                FontAttributes="Bold"
                VerticalTextAlignment="Center" />

            <Border Grid.Column="1"
                HeightRequest="50"
                VerticalOptions="Center">

                <Entry x:Name="productQuantity"
                    Margin="10"
                    Placeholder="Enter product quantity"
                    FontSize="18"
                    HeightRequest="35" 
                    Keyboard="Numeric"/>
            </Border>
        </Grid>

        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
            <Button x:Name="deleteBtn" Grid.Column="0" Clicked="Delete_Clicked" Text="Delete" FontSize="25" BackgroundColor="OrangeRed"></Button>
            <Button Grid.Column="1" Clicked="Save_Clicked" Text="Save" FontSize="25" BackgroundColor="ForestGreen"></Button>
        </Grid>

    </VerticalStackLayout>
</ContentPage>